node_modules/
dist/
.local/
runtime/
logs/
releases/
shots/
.playwright-mcp/
deploy/production/
# 任何位置的 .env（AI key / 凭据只放这里，绝不进仓库）；.env.example 是模板，要保留
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db

# 临时脚本/一次性分析（避免误提交）
.tmp-*

# 发布包生成的版本文件（只有 releases/<版本>/ 里该有；本地放一份会让 dev 读到假版本）
/VERSION

# 编码工具的会话产物（计划模式等），不进仓库
.zcode/
