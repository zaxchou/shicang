# 复制为 deploy/production/.env 并按 NAS 实际情况修改（本机 192.168.31.246 已核实值如下）
# Obsidian vault 根目录（**不是** RedNote 子目录）：RedNote/Bookmarks、我的收藏品、flomo
# 三个收藏库都相对它解析；指到 RedNote 会报「内容目录缺失或不可读: 我的收藏品」
# NAS 上的本机真实路径（已在 2026-09-27 核实）
SOURCE_ROOT=/volume2/Media/BaiduNetdiskWorkspace/mynote/mynote

# 局域网访问端口（已核实 4317 空闲）
MYINFOBASE_PORT=4317

# NAS 的局域网 IP
NAS_IP=192.168.31.246

# 当前运行的版本标签（与 releases/<版本> 目录一致；首次部署前先用 release.ps1 打包）
MYINFOBASE_TAG=0.12.0

# 容器内运行身份 = 共享目录属主（zaxchou uid=1026, users gid=100），已核实
CONTAINER_UID=1026
CONTAINER_GID=100

# ---- AI 分类兜底（可选）：规则未命中时调用 OpenAI 兼容接口；留空则新笔记进未分类 ----
AI_CLASSIFY_API_KEY=
AI_CLASSIFY_BASE_URL=https://api.xiaomimimo.com/v1
AI_CLASSIFY_MODEL=mimo-v2.6-flash
# 单次刷新的 AI 调用上限（分类表被重置或一次导入几百篇时防打爆配额）
AI_CLASSIFY_MAX_PER_REFRESH=40
# 单次请求超时（毫秒）
AI_CLASSIFY_TIMEOUT_MS=30000

# ---- 图片 OCR / 语音转录（可选，同样要先有 AI_CLASSIFY_API_KEY）----
# 以下都已列入 compose 的 environment 白名单（.env 里改了能生效），也都有代码默认值；
# 留空 = 用默认值（视觉模型默认跟随 AI_CLASSIFY_MODEL）
AI_VISION_MODEL=
AI_ASR_MODEL=mimo-v2.5-asr
AI_ASR_TIMEOUT_MS=300000
AI_ASR_MAX_PER_NOTE=4
AI_OCR_TIMEOUT_MS=120000
AI_OCR_MAX_PER_NOTE=8

# 刷新后自动重导语料（只认 false/0/no/off 为关）
# EXPORT_AFTER_REFRESH=true
