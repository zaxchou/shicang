# 复制为 deploy/production/.env 并按 NAS 实际情况修改（本机 192.168.31.246 已核实值如下）
# RedNote 目录在 NAS 上的本机真实路径（已在 2026-09-27 核实）
SOURCE_ROOT=/volume2/Media/BaiduNetdiskWorkspace/mynote/mynote/RedNote

# 局域网访问端口（已核实 4317 空闲）
MYINFOBASE_PORT=4317

# NAS 的局域网 IP
NAS_IP=192.168.31.246

# 当前运行的版本标签（与 releases/<版本> 目录一致）
MYINFOBASE_TAG=0.1.3

# 容器内运行身份 = 共享目录属主（zaxchou uid=1026, users gid=100），已核实
CONTAINER_UID=1026
CONTAINER_GID=100

# ---- AI 分类兜底（可选）：规则未命中时调用 OpenAI 兼容接口；留空则新笔记进未分类 ----
AI_CLASSIFY_API_KEY=
AI_CLASSIFY_BASE_URL=https://api.xiaomimimo.com/v1
AI_CLASSIFY_MODEL=mimo-v2.6-flash
